// ─── HELPERS DE PÁRRAFOS ──────────────────────────────────────────────────────

function body(text, opts = {}) {
  return new Paragraph({
    spacing: { after: 160, before: 0 },
    alignment: opts.center
      ? AlignmentType.CENTER
      : opts.justify !== false ? AlignmentType.JUSTIFIED : AlignmentType.LEFT,
    children: [new TextRun({ text, font, size: bodySize, bold: opts.bold || false, italics: opts.italic || false })],
  });
}

function bodyRuns(runs, opts = {}) {
  return new Paragraph({
    spacing: { after: 160, before: 0 },
    alignment: opts.center
      ? AlignmentType.CENTER
      : opts.justify !== false ? AlignmentType.JUSTIFIED : AlignmentType.LEFT,
    children: runs.map(r => new TextRun({ font, size: bodySize, ...r })),
  });
}

function h1(text) {
  return new Paragraph({
    spacing: { before: 0, after: 120 },
    alignment: AlignmentType.LEFT,
    children: [new TextRun({ text, font, size: h1Size, bold: true })],
  });
}

function h2(text) {
  return new Paragraph({
    spacing: { before: 640, after: 100 },
    children: [new TextRun({ text, font, size: h2Size, bold: true })],
  });
}

function h2Grande(text) {
  return new Paragraph({
    spacing: { before: 640, after: 100 },
    children: [new TextRun({ text, font, size: h2BigSize, bold: true })],
  });
}

function spacer() {
  return new Paragraph({ spacing: { after: 80 }, children: [new TextRun({ text: '', font, size: bodySize })] });
}

function doubleSpacer() {
  return [spacer(), spacer()];
}

function tripleSpacer() {
  return [spacer(), spacer(), spacer()];
}

function bullet(text, opts = {}) {
  return new Paragraph({
    spacing: { after: 120 },
    numbering: { reference: 'bullets', level: opts.level || 0 },
    children: [new TextRun({ text, font, size: bodySize })],
  });
}

function bulletCuarta(text) {
  return new Paragraph({
    spacing: { after: 120 },
    numbering: { reference: 'bullets-cuarta', level: 0 },
    children: [new TextRun({ text, font, size: bodySize })],
  });
}

function numbered(text) {
  return new Paragraph({
    spacing: { after: 120 },
    numbering: { reference: 'numbers', level: 0 },
    children: [new TextRun({ text, font, size: bodySize })],
  });
}

// Sub-título de sección dentro de una cláusula (ej: "Desarrollo web. Incluye:")
function subh(text) {
  return new Paragraph({
    spacing: { before: 240, after: 80 },
    indent: { left: 720 },
    children: [new TextRun({ text, font, size: bodySize, bold: true })],
  });
}

